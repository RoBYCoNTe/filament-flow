includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src/
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # The traits in src/Concerns are public API for host applications (their
        # models use them); the package itself only consumes the contracts, so
        # static analysis sees them as unused.
        - identifier: trait.unused
          paths:
              - src/Concerns/*
